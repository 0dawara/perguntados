# Configuração Back4App
# Copie este arquivo para .env e preencha os valores antes de inicializar o app.

# App ID fornecido no painel do Back4App (Segurança > Chaves)
PARSE_APP_ID=seu_application_id_aqui

# Client Key (ou JavaScript Key, dependendo de como o SDK foi inicializado)
PARSE_CLIENT_KEY=sua_client_key_aqui

# URL de Servidor do Parse
PARSE_SERVER_URL=https://parseapi.back4app.com/
